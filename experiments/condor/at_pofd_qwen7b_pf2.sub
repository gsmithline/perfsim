# HTCondor: DATA-REGIME WAVE, W=0.5 FJ ENVIRONMENT (pofdpf2_), Qwen-7B,
# seed 0. 20 runs: PRISTINE_FRAC {1,0.75,0.5,0.25,0} x eps_AI
# {0.05,0.1,0.2,0.4}, beta=0 (style sft, NO KL -- direction-free), DATA_
# REGIME=accumulate: each 723-row retrain batch pins round(pf*723) rows to
# the round-0 innate seed (mix_pristine_data), rest from the loop buffer.
# The env2 port of at_pofd_qwen7b_pfrac.sub: corrected operator, W_PLAT=0.5
# (queue col 12), INNATE_LAMBDA=0.2, eps_social=0.
# The science: w2f anchors to the model's PRIOR and at b1_ea0p4 that anchor
# CAUSES 234 attributable captures; this wave anchors to the ORIGINAL DATA
# instead, asking whether a data anchor prevents capture rather than causing
# it. pf=0 is the plain-accumulate control (the honest no-anchor column --
# the regime differs from w2f's fresh-replace rows).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# No smoke needed here: accumulate x pf proven by the W=1 pfrac wave, the
# env2 operator by w2f/icl2. Flow: qwen7b_pfs2_smoke PASS gates BOTH sides.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_pf2
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) PRISTINE_FRAC=$(pfrac) INNATE_LAMBDA=0.2 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdpf2"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac from experiments/condor/configs_pofd_qwen7b_pf2.txt
