# HTCondor: SHARED-BASE control for the competition runs.
#
# Same 3-platform Pokec FJ competition as at_pokec_fj_competition.sub, but all
# three platforms are LoRA copies of ONE base (Qwen2.5-1.5B). Distinct-base
# results show the KL prior arrests homogenization; this control tests whether
# that protection survives when the priors are identical (competition without
# pluralism). beta {0,1,3,10} x seed {0,1,2} at tau=0.05 = 12 runs.
#
# Submit: condor_submit_bid <BID> experiments/condor/at_pokec_fj_competition_shared.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_competition.sh
arguments         = $(tag) $(style) $(klbeta) $(tau) $(seed)

request_cpus      = 4
request_memory    = 64G
request_disk      = 30G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 40000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-pokec-fj-competition N_ROUNDS=25 EPOCH_SIZE=100 GEN_BATCH_SIZE=32 BASE_MODELS=Qwen/Qwen2.5-1.5B-Instruct,Qwen/Qwen2.5-1.5B-Instruct,Qwen/Qwen2.5-1.5B-Instruct"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 1
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, klbeta, tau, seed from experiments/condor/configs_pokec_competition_shared.txt
