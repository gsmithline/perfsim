# HTCondor: W=0.5 FJ + PEER WAVE (pofdws_), Qwen-7B, seed 0. 20 runs: beta
# {0,0.1,0.2,0.5,1} x eps_AI {0.05,0.1,0.2,0.4} -- the core grid on the SECOND
# population-realism rung: same (W_PLAT=0.5, INNATE_LAMBDA=0.2) point as
# at_pofd_qwen7b_w.sub PLUS the peer step live, EPS_SOCIAL=0.2 (queue col 10;
# classic Deffuant bounded-confidence radius, in-radius pairs move to their
# midpoint). Round order: peer sweep -> gated platform blend -> FJ anchor.
# The no-AI twin is NO LONGER frozen innate: the pipeline simulates it
# (same peer sweeps, mirrored RNG, never gated) and saves twin_raw to
# trajectory.pt -- displacement is measured vs the twin, not innate.
# ANS_SAMPLE_K=16 probe ON. Peer moves are RNG-pairwise, so check_pofd_sanity
# applies the weaker pofdws gate (config + peer-alive + twin + finiteness).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Flow: submit qwen7b_ws_smoke first (3 rounds) -> sanity PASS -> qwen7b_ws.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_ws
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdws"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b_ws.txt
