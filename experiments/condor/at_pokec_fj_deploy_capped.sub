# HTCondor: deployment schedule experiment, FIXED-SIZE control (initial test).
#
# Same 6 deployment cells x beta {0,1,3}, 1 seed = 18 runs, BUT every regime is
# capped to the same training-set size per round (TRAIN_CAP=1730), so all regimes
# do equal training volume. This isolates the data-composition effect (which rounds
# you train on) from the overtraining confound (how much you train). Real base data
# is in the buffer (SEED_BASE_DATA=1), so accumulate/not_deployed_into still include
# it per their own selection logic. Capping also makes accumulate cheap (1730 rows,
# not ~47k), so these are all fast runs.
#
# Compare against the uncapped grid (at_pokec_fj_deploy_grid.sub): if accumulate is
# healthy here but collapsed there, the collapse was overtraining/volume, not stale
# composition. style is per-row (sft for beta=0, sft_kl for beta>0).
#
# Submit: condor_submit_bid <BID> experiments/condor/at_pokec_fj_deploy_capped.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_fj.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-pokec-fj-lm N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=1730 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 SEED_BASE_DATA=1 TRAIN_CAP=1730 WANDB_RUN_SUFFIX=_qwen7b_lora512"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime from experiments/condor/configs_pokec_fj_deploy_capped.txt
