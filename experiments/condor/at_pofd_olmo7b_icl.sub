# HTCondor: ICL WAVE, OLMO-2-7B-Instruct (pofdicl_olmo7b_).
# 32 runs: 8 context arms (k0, k8live, k32live, k32pri, d5, d10, d15, d30) x eps_AI {0.05,0.1,0.2,0.4}, seed 0.
# The olmo twin of at_pofd_qwen7b_icl.sub -- identical design (see its header):
# adaptation via CONTEXT, frozen weights, no gradients (TRAINING_STYLE=frozen,
# USE_LORA=0, FRESH_EACH_ROUND=0), same pofd population channel.
# Model deltas only: BASE_MODEL allenai/OLMo-2-1124-7B-Instruct,
# HF_HOME=/lustre/fast/fast/gsmithline/hf_cache (OLMo lives in a SEPARATE HF
# cache -- without this it dies "couldn't find in cached files" under
# HF_HUB_OFFLINE=1, see BATCHES.md gotcha 2026-07-15), PPL_BATCH=16 (no GQA ->
# fat KV cache), request_memory 160G / disk 60G per the prior OLMo cells.
# W_PLAT=1, INNATE_LAMBDA=0, eps_social=0: the corner where the 2026-07-27
# population-update correction is a no-op, so these are directly comparable to
# the qwen ICL wave (32/32 done) whichever side of the fix they run on.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Flow: submit olmo7b_icl_smoke first (3 rounds) -> sanity PASS -> olmo7b_icl.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7b_icl
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=random ICL_CTX_SOURCE=$(iclsrc) USE_LORA=0 FRESH_EACH_ROUND=0 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7b_pofdicl"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, iclk, icldays, iclsrc from experiments/condor/configs_pofd_olmo7b_icl.txt
