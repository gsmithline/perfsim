# HTCondor: pofdws2_ SMOKE -- 1 job, 3 rounds, distinct pofdws2smk_ tag.
# The sft_kl beta=0.5 ea=0.2 cell with the peer step live.
# The corrected round operator (config population_update="nested_ai_then_social_v1"):
#     h_i(t) = k x_innate,i + (1-k) x_i(t)
#     z_i(t) = (1-W) h_i(t) + W m_i(t)  if |m_i(t) - x_i(t)| < eps_AI, else h_i(t)
#     x(t+1) = D_eps_social(z(t))
# Gate on the START-OF-ROUND opinion x_i(t); the human/AI mixture happens ONCE
# per round; Deffuant peer sweeps run LAST. W=1 now returns z = m for every k,
# so the ladder W=1 -> W<1 -> eps_social>0 is properly nested. This SUPERSEDES
# the pofdw_/pofdws_ waves, which applied the innate anchor after the platform
# blend (diluting W m) and swept peers first. Distinct tags: these write new run
# dirs and never overwrite the superseded ones, and erm.is_clean_loop refuses to
# mix the two families.
# Identical env to at_pofd_olmo7b_ws2.sub except N_ROUNDS=3 + smoke suffix.
# Gate with check_pofd_sanity.py on
#   runs/pokec_gated_lm/pofdws2smk_olmo7b_b0p5_ea0p2_w0p5_l0p2_es0p2_s0_fresh_data
# (peer-alive + twin present + the mean-conservation check that the mixture ran
# before the peer sweep) and submit olmo7b_ws2 ONLY on PASS.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7b_ws2_smoke
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "DEBUG_GEN=1 DEBUG_GEN_N=12 REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=3 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7b_lora512_pofdws2smk"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_olmo7b_ws2_smoke.txt
