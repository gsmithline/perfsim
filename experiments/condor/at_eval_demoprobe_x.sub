# Tree-2 frozen counterfactual probe, CROSS-MODEL: 33 GPU shards =
# 11 target genres x {Llama-3.1-8B, OLMo-2-7B, Gemma-3-12b-it}. Same
# design as the Qwen probe (age curve 20-60 x gender + natural /
# natural_full / nodemo, tastes fixed, occupation omitted from
# counterfactuals+bridge, greedy). Decides whether the stereotype map and
# the War x gender selection are model-general or Qwen-specific.
# Frozen generation only -- Gemma works here (frozen arms already ran);
# only Gemma RETRAINING is env-blocked. GEN_CHUNK 32 for the 12B.
# Output: runs/pokec_gated_lm/demo_probe_<model>/probe_<target>.json
# (SKIP_DONE=1, any shard safe to rerun). Read registered in
# notes/QUESTIONS.md Q7 before submit.
# Submit: condor_submit_bid <BID> experiments/condor/at_eval_demoprobe_x.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_eval_demo_probe.sh
arguments         = $(tgt) $(model) $(outdir) $(chunk) $(hfhome)

request_cpus      = 4
request_memory    = 64G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 79000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn AGES=20,30,40,50,60 SKIP_DONE=1 HF_HUB_OFFLINE=1"

output            = /home/gsmithline/perfsim/experiments/condor/logs/demoprobe_$(mtag)_$(safe).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/demoprobe_$(mtag)_$(safe).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/demoprobe_$(mtag)_$(safe).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tgt, safe, model, mtag, outdir, chunk, hfhome from experiments/condor/configs_demoprobe_x.txt
