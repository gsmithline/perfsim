# HTCondor: FORWARD-KL WAVE (canonical 2026-07-29), W=0.5 FJ + PEER
# ENVIRONMENT (pofdws2f_), Qwen-7B, seed 0.
# 16 runs: beta {0.1,0.2,0.5,1} x eps_AI {0.05,0.1,0.2,0.4} -- the FULL
# beta>0 grid of the pofdws2_ wave (corrected operator, W_PLAT=0.5,
# INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2 queue col 10; expanded from the 6 key
# cells 2026-07-29 so the forward wave can replace ws2 in every figure) with
# KL_DIRECTION=forward (KL(ref || pi), mass-covering; the paper's canonical
# anchor from 2026-07-29 -- reverse pofdws2_ remains as the RLHF-practice
# comparison; beta=0 is direction-independent, reuse pofdws2_ b0). The ea0p4
# cells re-test the reverse-KL beta in (0.5,1] phase transition (b0p5: peers
# dissolve the camp + model retrains out of its prior; b1: persistent
# ~200-agent camp) under the forward anchor -- given the W=1 result (forward
# kills the b0p5 prior mode outright but reproduces the b1 camp), the open
# question is whether the b1 camp still survives peers when the anchor is
# mass-covering. The ea0p2 cells are the narrow-gate amplification pair.
# No separate smoke: forward loss path validated by the w1f smoke+wave, env
# validated under reverse. Gate with check_pofd_sanity.py + config.json
# kl_direction=forward after pulling.
# Everything else IDENTICAL to at_pofd_qwen7b_ws2.sub, distinct pofdws2f_
# tags. Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_ws2f
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) KL_DIRECTION=forward INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdws2f"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b_ws2f.txt
