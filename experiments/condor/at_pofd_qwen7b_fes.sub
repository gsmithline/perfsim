# HTCondor: FEATURE-ENDOGENIZATION RERUNS, natural-gender seed arm (fes),
# Qwen-7B. 6 runs: beta {0, 0.5, 1} x seeds {42, 43} at ea0p4 in the peer
# environment (W_PLAT=0.5, INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2), forward KL,
# replace + fresh adapter each round. Tags stay in the pofdws2f_ family
# (these ARE ws2f replication seeds; the b0 rows are style sft,
# direction-free, matching the olmo w2f convention). The s0 anchors exist
# and are NOT re-run: pofdws2_ b0 (reverse tag, identical physics at b0),
# pofdws2f_ b0p5/b1. Twin forced on every run (eps>0); per-agent op_raw/
# pred_raw/twin_raw land in trajectory.pt as always.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# No smoke: byte-identical env to the validated ws2f wave, seeds only.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_fe
#         (composite: fes + fegd + fegp + fef), or qwen7b_fes alone.
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) KL_DIRECTION=forward INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdfes"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b_fes.txt
