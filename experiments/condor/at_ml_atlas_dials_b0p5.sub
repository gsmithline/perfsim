# HTCondor: DIAL beta=0.5 ROWS, 14 runs, rep/continual, carry, seed 0.
# Gate dial: eps_AI {0.05,0.15,0.30,0.70,1.0} at e040, natural data
# (a010/a020/a040 at b0p5 exist via mla2bv2/mlat). Feature dial: trap cell,
# PROFILE_SHUFFLE_P {.05,.15,.33,.40,.65,1} + PROFILE_SORT_Q {.25,.5,1}
# (natural b0p5 exists). Completes the beta {0, 0.5, 1} rows of the knob
# plane; 0.5 is where the model-vs-population trade is sharpest.
# Submit: condor_submit_bid <BID> experiments/condor/at_ml_atlas_dials_b0p5.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens PROFILE_SHUFFLE_P=$(shufp) PROFILE_SORT_Q=$(sortq) ML_TARGET=Action EPS_AI=$(eps_ai) PRISTINE_FRAC=$(pfrac) FRESH_EACH_ROUND=$(fresh) TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_mlatdial_b0p5"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac, fresh, shufp, sortq from experiments/condor/configs_ml_atlas_dials_b0p5.txt
