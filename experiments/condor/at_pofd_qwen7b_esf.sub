# HTCondor: EPS-SOCIAL DOSE-RESPONSE at the forward-KL headline cell
# (pofdesf_), Qwen-7B, seed 0.
# 7 runs, everything FIXED except the repair channel: forward KL, beta=1,
# eps_AI=0.4, INNATE_LAMBDA=0.2 (queue cols carry eps_social + W_PLAT):
#   W=0.5: es {0.10, 0.15, 0.25}  -- es=0 IS pofdw2f_qwen7b_b1_ea0p4 (234
#          attributable) and es=0.20 IS pofdws2f_qwen7b_b1_ea0p4 (the 198->3
#          dissolution cell): identical physics, REUSED in analysis, not
#          re-run here.
#   W=1:   es {0, 0.20, 0.30, 0.40} -- all 4 run: lam=0.2 differs from the
#          w1f environment (lam=0 froze ungated agents) and W=1 + peers is
#          a new combination, so nothing is reusable, incl. the es=0 base.
# The science: locate the transition where Deffuant repair starts beating
# the mass-covering anchor. At W=0.5 the camp holds at es=0 and is gone by
# es=0.20 -- the 0.10/0.15 doses bracket the transition, 0.25 confirms the
# far side. At W=1 the loop is fully self-sustaining at es=0 (~330 camp);
# the wider doses (0.30/0.40, chosen because captured agents sit ~0.25 and
# need a radius that reaches the 0.5+ mainstream) ask how much repair a
# W=1 platform needs before capture dissolves at all.
# WITH_TWIN=1: EVERY run saves the matched no-platform twin (twin_raw;
# RNG-mirrored peer moves, deterministic innate drift at es=0), so
# attributable capture = op<0.45 & twin>=0.45 uniformly across the ladder.
# Flow: this wave is the seed-0 transition scan. After analysis, fill
# ESF_REPL_POINTS in gen_pofd_sweep.py with the important (w, es) cells,
# regenerate, and submit qwen7b_esf_repl (seeds 42 + 43).
# check_pofd_sanity routes by the _w/_l/_es tokens: es>0 rows get the peer
# gate (mean-conservation + twin), es=0 rows the exact replay. Gate every
# pull on it + config.json kl_direction=forward.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_esf
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) KL_DIRECTION=forward WITH_TWIN=1 INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdesf"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b_esf.txt
