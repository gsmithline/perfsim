# HTCondor: ICL FEATURE-ENDOGENIZATION, gender-PERMUTED arm (feigp), Qwen-7B.
# 3 runs: k8live ea0p4 x seeds {0, 42, 43} in the peer environment
# (W_PLAT=0.5, INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2 queue col 10), frozen
# weights, 30 rounds. PROFILE_PERMUTE_COLS=gender shuffles the DISPLAYED
# gender across agents (served profile AND exemplar lines; innate opinions,
# graph, and all other fields untouched) -- the in-context mirror of
# pofdfegp_ (SFT-KL b1): the gender-opinion association is broken while the
# marginal gender distribution survives. Permutation is seeded by the run
# seed ONLY (saved to permute_cols.json) -- SAME per-seed permutation as
# fegp/fegp2/fegpr/fegpc/fegpj, deliberate: matched within seed across
# mechanisms. Config records profile_permute_cols=['gender'];
# check_pofd_sanity gates it for the pofdicls2gp_ prefix, which keeps the
# "pofdicl" checker family (frozen + arm gates; arm token k8live directly
# before _s<seed>). Env VERBATIM from at_pofd_qwen7b_icls2.sub +
# PROFILE_PERMUTE_COLS + suffix. Natural-gender counterparts: pofdicls2_
# k8live s0 (icls2 wave, reused) + s42/s43 (feik).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# No smoke: gperm x ICL exemplars proven by the old icl_endog_gperm wave
# (the knob acts once at profile build, before the loop); frozen x twin x
# peers by the icls2 smoke + wave.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_fei
#         (composite: feik + feigd + feigp), or qwen7b_feigp alone.
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action PROFILE_PERMUTE_COLS=gender EPS_AI=$(eps_ai) ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=random ICL_CTX_SOURCE=$(iclsrc) INNATE_LAMBDA=0.2 USE_LORA=0 FRESH_EACH_ROUND=0 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_pofdicls2gp"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, iclk, icldays, iclsrc from experiments/condor/configs_pofd_qwen7b_feigp.txt
