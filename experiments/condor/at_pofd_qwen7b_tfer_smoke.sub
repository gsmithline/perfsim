# HTCondor: RANDOM-EVEN-SPLIT TEACHER FE SMOKE, 1 job, 3 rounds (tpos s0).
# Gates the qwen7b_tfer wave: NEW combination of (a) the pofdtchr_ +0.08
# teacher adapter as KL reference (never loaded before), (b) the
# random_even sentinel path ACTIVE IN A LOOP (split rebuilt for telemetry
# grouping, delta 0, gg keys grouped by the synthetic split, real gender
# one-hot inside the R^2 covariates). Verify: merged ref loads offline,
# 3 rounds finite, config records col=random_even fav=A group_seed=0 +
# kl_ref_adapter + delta 0, random_group.json written, gg_*_true keys
# present every round with NO _disp keys, check_pofd_sanity PASS
# (is_tfe pofdtfer branch). Env identical to at_pofd_qwen7b_tfer.sub
# except N_ROUNDS=3 + DEBUG_GEN.
# PREREQ: qwen7b_tchr pair finished + gap gate passed.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_tfer_smoke
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "DEBUG_GEN=1 DEBUG_GEN_N=12 REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) KL_DIRECTION=forward KL_REF_ADAPTER=$(refadapter) TEACHER_LABEL_COL=random_even TEACHER_LABEL_FAV=A TEACHER_GROUP_SEED=0 LOG_GENDER_GAPS=1 INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=3 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdtfersmk"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, refadapter from experiments/condor/configs_pofd_qwen7b_tfer_smoke.txt
