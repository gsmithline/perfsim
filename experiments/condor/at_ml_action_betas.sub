# HTCondor: KL beta dose sweep, MovieLens-Action (LLM). 9 runs, post-fix.
#
# beta {0.1, 0.5, 1.0} x three cells, replace/continual, seed 0, 30 rounds.
# ML previously had only beta {0, 3}; this fills the middle to answer:
#   e040_a040  trap vs displacement: is there a beta that stops the ppl drift
#              without displacing the population toward the prior modes?
#   e040_a010  consensus capture: how much anchor does the dr->0 capture need?
#   e020_a040  bimodal smear onset (b3 gave dr=1.39, mass on 0.25/0.65).
# Also read prediction-value quantization vs beta (n_unique / top-mode mass);
# Pokec innate-sweep saw a beta threshold near 0.5.
# Compare against mla2dv2_* (b0, b3 endpoints). v2-era tags = post-RNG-fix.
# Submit: condor_submit_bid <BID> experiments/condor/at_ml_action_betas.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_mla2bv2"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_ml_action_betas.txt
