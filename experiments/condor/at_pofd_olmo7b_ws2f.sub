# HTCondor: FORWARD-KL WAVE (canonical 2026-07-29), W=0.5 FJ + PEER
# ENVIRONMENT (pofdws2f_), OLMo-2-7B-Instruct, seed 0.
# 16 runs: beta {0.1,0.2,0.5,1} x eps_AI {0.05,0.1,0.2,0.4} -- the full
# beta>0 grid of the pofdws2_ olmo wave (corrected operator, W_PLAT=0.5,
# INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2 queue col 10) with KL_DIRECTION=forward.
# The olmo twin of at_pofd_qwen7b_ws2f.sub. The science: the qwen headline is
# that peers DISSOLVE the reverse-KL persistent b1_ea0p4 camp under forward
# (198->3; the whole forward ea0p4 column is 0/0/0/3) -- but qwen's prior
# mode (0.25) sits OUTSIDE the data's range, and olmo's (0.75 spike) sits
# INSIDE it, where the w1f wave showed forward is not protective (b0p1
# captures MORE). This grid asks whether social repair still beats a
# mass-covering pull toward an in-range prior, or whether olmo's forward
# camps survive peers where qwen's could not. Capture metrics use the
# HIGH-side mirror (op>0.70 vs twin_raw). beta=0 is direction-independent --
# reuse pofdws2_ olmo b0.
# Reverse twins: pofdws2_olmo7b_b*. Model deltas vs the qwen sub: BASE_MODEL,
# the separate lustre HF cache + HF_HUB_OFFLINE=1 (BATCHES.md gotcha
# 2026-07-15), PPL_BATCH=16 (no GQA), request_memory 160G / disk 60G.
# No separate smoke: forward loss path validated by the w1f smoke+wave, olmo
# model + peer env validated by its reverse ws2 wave. Gate the pulled runs on
# check_pofd_sanity.py + config.json kl_direction=forward.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7b_ws2f
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) KL_DIRECTION=forward INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7b_lora512_pofdws2f"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_olmo7b_ws2f.txt
