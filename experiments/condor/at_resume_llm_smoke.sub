# HTCondor: single small test of the resume rewriting loop (3 rounds, 7B).
# Validates the GPU pipeline before the full grid (at_resume_llm_loop.sub).
# Submit: condor_submit_bid <BID> experiments/condor/at_resume_llm_smoke.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_resume_llm.sh
arguments         = resume_smoke replace experience 0

request_cpus      = 4
request_memory    = 64G
request_disk      = 30G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 40000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-resume-llm BASE_MODEL=Qwen/Qwen2.5-7B-Instruct N_ROUNDS=3 MAX_NEW_TOKENS=768 GEN_BATCH_SIZE=16 ANCHOR_ALPHA=0.3 WANDB_RUN_SUFFIX=_smoke"

output            = /home/gsmithline/perfsim/experiments/condor/logs/resume_smoke.out
error             = /home/gsmithline/perfsim/experiments/condor/logs/resume_smoke.err
log               = /home/gsmithline/perfsim/experiments/condor/logs/resume_smoke.log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 1
on_exit_hold      = (ExitCode =!= 0)

queue
