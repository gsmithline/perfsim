# HTCondor: IN-CONTEXT WAVE, W=0.5 FJ ENVIRONMENT (pofdicl2_), OLMo-2-7B,
# seed 0. 32 runs: 8 arms x eps_AI {0.05,0.1,0.2,0.4} -- the olmo twin of
# at_pofd_qwen7b_icl2.sub (corrected operator, W_PLAT=0.5 queue col 12,
# INNATE_LAMBDA=0.2, eps_social=0). Frozen weights, no gradients,
# KL-direction-free.
# The science: qwen's env2 grid showed live exemplars amplify capture 1.8x
# over the frozen baseline while personal-memory d-arms suppress it by an
# order of magnitude. Olmo's prior is a single spike at 0.75 INSIDE the
# population's range (qwen's 0.25 mode is outside) -- this grid asks
# whether the d-arm protection and live-context amplification survive an
# in-range prior. Capture metrics use the HIGH-side mirror (op>0.70,
# innate<=0.70). noai skipped (== pristine at eps_social=0); the peer twin
# at_pofd_olmo7b_icls2.sub carries k32noai.
# Model deltas vs the qwen sub: BASE_MODEL, lustre HF cache +
# HF_HUB_OFFLINE=1 (BATCHES.md gotcha 2026-07-15), PPL_BATCH=16 (no GQA),
# request_memory 160G / disk 60G. ICL_SELECT=random, USE_LORA=0; the
# wrapper auto-drops GEN_BATCH_SIZE for K>=32 (long prompts, fat KV cache).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# No smoke: frozen path validated by the W=1 olmo icl wave, env2 by the
# olmo w2 wave, frozen x twin x peers by the qwen icls2 smoke + wave.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7b_icl2
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=random ICL_CTX_SOURCE=$(iclsrc) INNATE_LAMBDA=0.2 USE_LORA=0 FRESH_EACH_ROUND=0 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7b_pofdicl2"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, iclk, icldays, iclsrc from experiments/condor/configs_pofd_olmo7b_icl2.txt
