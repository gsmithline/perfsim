# HTCondor: RANDOM-EVEN-SPLIT TEACHER FE WAVE (pofdtfer_), Qwen-7B, 6 jobs.
# Twin of at_pofd_qwen7b_tfem.sub with the pofdtchr_ teachers: KL ref
# {tpos +0.08, tneg -0.08} keyed on the SYNTHETIC balanced split (queue
# col 16 = adapter path) x seeds {0, 42, 43}. Env3 forward SFT-KL: b1,
# ea0p4, W_PLAT=0.5, INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2 (queue col 10),
# fresh + replace, 30 rounds. TEACHER_LABEL_COL=random_even FAV=A
# GROUP_SEED=0 here only rebuilds the SAME deterministic split for the
# gg telemetry grouping (TEACHER_LABEL_DELTA stays 0 -- the signal lives
# only in the reference weights). No prompt feature marks the group: any
# transfer is instance-memorization through the token-level KL channel.
# tneu is NOT re-run: the pofdtfe_ tneu trajectories are physics-identical
# (same neutral teacher, seeds, env) -- their random-group gaps are
# recomputed offline from saved op/pred/twin_raw + the deterministic
# split. No gdrop/gperm arms (nothing displayed to drop or permute).
# PREREQ: qwen7b_tchr pair finished + gap gate (signs/collapse/ordering
# hard, |gap| >= 0.05 to proceed). GATE: qwen7b_tfer_smoke PASS first.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_tfer
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) KL_DIRECTION=forward KL_REF_ADAPTER=$(refadapter) TEACHER_LABEL_COL=random_even TEACHER_LABEL_FAV=A TEACHER_GROUP_SEED=0 LOG_GENDER_GAPS=1 INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdtfer"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, refadapter from experiments/condor/configs_pofd_qwen7b_tfer.txt
