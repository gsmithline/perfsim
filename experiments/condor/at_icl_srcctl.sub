# FIG-4 ICL CONTEXT-SOURCE CONTROL (registered QUESTIONS.md Q8 addendum
# 2026-07-18): frozen serving + K32 exemplar context whose LABELS come from a
# counterfactual source -- noai = same users in the matched no-AI twin world
# (runner evolves it in-run, same AB seed, never gated); pristine = innate.
# Exemplar count/identities/order/format identical to the live k32 twin.
# qwen {e040,e010} x {noai,pristine} = 4 jobs, s0. Parent: at_spine_icl_k32.sub
# (env verbatim + ICL_CTX_SOURCE). Submit AFTER the smoke gate
# (at_icl_srcctl_smoke.sub) passes.
# Submit: condor_submit_bid <BID> experiments/condor/at_icl_srcctl.sub
#
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action GEMMA_ENV_NAME=opdyn HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) PRISTINE_FRAC=$(pfrac) FRESH_EACH_ROUND=$(fresh) TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=$(base) SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=$(uselora) SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_icl_srcctl ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=$(iclsel) ICL_CTX_SOURCE=$(iclsrc)"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac, fresh, base, uselora, iclk, icldays, iclsel, iclsrc from experiments/condor/configs_icl_srcctl.txt
