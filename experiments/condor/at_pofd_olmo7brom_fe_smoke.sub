# HTCondor: OLMo ROMANCE FE SMOKE, 1 job, 3 rounds (ws2f b1_ea0p4 s0).
# Gates the olmo7brom_fe wave: ML_TARGET=Romance is a NEW production dial
# -- the movielens loader is target-generic but has never run off Action,
# and OLMo's zero-shot behavior on the Romance prompt (which excludes the
# Romance taste line and includes Action) is unmeasured. Verify: loader
# builds the n=723 Romance population, prompts read "likes Romance
# movies", predictions finite/valid in [0,1], 3 rounds of forward SFT-KL
# + peer step + twin complete, config records ml_target=Romance +
# base_model OLMo-2 + kl_direction=forward, check_pofd_sanity PASS
# (generic social branch + olmo7brom token gates). Everything else is
# validated: env3 operator + forward KL on olmo by its ws2f wave, frozen
# k0 + peers by olmo icls2, the seed protocol by qwen fes/fef.
# Env identical to at_pofd_olmo7brom_fes.sub except N_ROUNDS=3 +
# DEBUG_GEN (prints sample prompts/answers to the .out for eyeballing).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Flow: olmo7brom_fe_smoke -> pull + sanity PASS -> olmo7brom_fe (12 jobs).
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7brom_fe_smoke
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "DEBUG_GEN=1 DEBUG_GEN_N=12 REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Romance HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) KL_DIRECTION=forward INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=3 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7brom_lora512_pofdfesmk"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_olmo7brom_fe_smoke.txt
