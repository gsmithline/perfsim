# HTCondor: IN-CONTEXT WAVE, W=0.5 FJ + PEER ENVIRONMENT (pofdicls2_),
# OLMo-2-7B, seed 0. 36 runs: 9 arms x eps_AI {0.05,0.1,0.2,0.4} -- the
# olmo twin of at_pofd_qwen7b_icls2.sub (corrected operator, W_PLAT=0.5,
# INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2 queue col 10), incl. the k32noai arm
# (exemplar labels from the SYNCHRONIZED no-AI twin, which MOVES here).
# Frozen weights, no gradients, KL-direction-free.
# The science: qwen showed frozen weights flip social mixing from repair
# to delivery (k0 att 198 -> 259 with peers on; gate-mediated at ea0p2,
# 1 -> 50) because a frozen server never retrains out of its prior. Olmo's
# 0.75 spike sits INSIDE the population's range and its no-AI twin drifts
# toward the same region -- this grid asks whether peer delivery is even
# stronger when the destination basin overlaps the mainstream, and whether
# d-arm (personal memory) protection survives. Capture metrics: HIGH-side
# mirror (op>0.70 vs twin_raw).
# Model deltas vs the qwen sub: BASE_MODEL, lustre HF cache +
# HF_HUB_OFFLINE=1, PPL_BATCH=16, request_memory 160G / disk 60G.
# ICL_SELECT=random, USE_LORA=0. check_pofd_sanity: peer gate + icl arm
# checks, FRESH gate skipped (frozen, no n_train).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# No smoke: frozen x twin x peers validated by the qwen icls2 smoke + wave,
# olmo model path by its W=1 icl wave, olmo peer env by its ws2 wave.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7b_icls2
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=random ICL_CTX_SOURCE=$(iclsrc) INNATE_LAMBDA=0.2 USE_LORA=0 FRESH_EACH_ROUND=0 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7b_pofdicls2"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, iclk, icldays, iclsrc from experiments/condor/configs_pofd_olmo7b_icls2.txt
