# HTCondor: FEATURE-ENDOGENIZATION CONTINUAL-WEIGHTS MIRROR, natural-
# gender arm (fesc), Qwen-7B. 9 runs: beta {0, 0.5, 1} x seeds
# {0, 42, 43} at ea0p4 in the peer environment (W_PLAT=0.5,
# INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2), forward KL, replace data,
# FRESH_EACH_ROUND=0: the adapter PERSISTS and keeps training across
# rounds (continual SFT, the runner's native default; the forward KL
# term still anchors every round to the FIXED pristine base). New
# pofdws2fc_ family -- NO anchors exist, all 9 cells run (b0 rows are
# style sft, direction-free). The _fresh_data suffix names the DATA
# protocol (replace, n_train=723 every round); only weights carry over.
# Twin forced on every run (eps>0).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# SMOKE FIRST: continual training is a NEW physics combination in the
# corrected era. Submit qwen7b_fec_smoke (1 job, 3 rounds), gate with
#   python experiments/scripts/cluster_pipelines/check_pofd_sanity.py \
#       runs/pokec_gated_lm/pofdws2fcsmk_qwen7b_b1_ea0p4_w0p5_l0p2_es0p2_s0_fresh_data
# and only on PASS submit qwen7b_fec (composite: fesc + fegdc + fegpc).
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) KL_DIRECTION=forward INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=0 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdfesc"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b_fesc.txt
