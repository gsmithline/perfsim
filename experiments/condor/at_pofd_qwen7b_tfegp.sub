# HTCondor: CONTROLLED-TEACHER FE WAVE, gender-PERMUTED arm (tfegp), Qwen-7B.
# 3 runs: +0.08 teacher (KL_REF_ADAPTER hardcoded below) with
# PROFILE_PERMUTE_COLS=gender on the STUDENT side x seeds {0, 42, 43}.
# Env3 forward SFT-KL: b1, ea0p4, W_PLAT=0.5, INNATE_LAMBDA=0.2,
# EPS_SOCIAL=0.2 (queue col 10), fresh + replace, 30 rounds. The
# RANDOMIZED-FEATURE test: displayed gender is shuffled across agents
# (marginal preserved, person-feature link broken; permutation seeded by
# run seed ONLY, saved to permute_cols.json -- same per-seed permutation
# as every fe wave). If the teacher's +0.08 association transfers, it must
# follow the DISPLAYED feature (gg_*_disp), not real gender (gg_*_true).
# Teacher prompts unchanged (identical teacher/student prompts for the
# token-level KL; the permute acts on the shared profile table at build
# time, exactly as in pofdfegp_). LOG_GENDER_GAPS=1 logs both gap families
# + incremental R^2 (true and displayed) per round.
# PREREQ + GATE: same as at_pofd_qwen7b_tfem.sub (tch pair + tfe smoke).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_tfe
#         (composite: tfem + tfegd + tfegp), or qwen7b_tfegp alone.
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action PROFILE_PERMUTE_COLS=gender EPS_AI=$(eps_ai) KL_DIRECTION=forward KL_REF_ADAPTER=/home/gsmithline/perfsim/runs/pokec_gated_lm/pofdtch_qwen7b_dp0p08_ea0p4_w0p5_l0p2_s0/round0_adapter LOG_GENDER_GAPS=1 INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdtfegp"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b_tfegp.txt
