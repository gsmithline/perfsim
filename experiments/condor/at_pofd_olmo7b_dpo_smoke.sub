# HTCondor: SHARP DPO WAVE, OLMO-2-7B-Instruct SMOKE (pofddpo_olmo7b_).
# 1 job, 3 rounds, distinct pofddposmk_olmo7b_ tag.
# The olmo twin of at_pofd_qwen7b_dpo.sub -- identical design (see its header);
# model deltas only: BASE_MODEL allenai/OLMo-2-1124-7B-Instruct,
# HF_HOME=/lustre/fast/fast/gsmithline/hf_cache (OLMo lives in a SEPARATE HF
# cache -- without this it dies "couldn't find in cached files" under
# HF_HUB_OFFLINE=1, see BATCHES.md gotcha 2026-07-15), PPL_BATCH=16 (no GQA ->
# fat KV cache), request_disk 60G per the prior OLMo cells.
# Population channel is W_PLAT=1, INNATE_LAMBDA=0, eps_social=0, i.e. the corner
# where the 2026-07-27 population-update correction is a no-op, so these runs are
# directly comparable to the qwen DPO wave and to the olmo7b SFT/KL wave whether
# they run before or after the fix.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Gate with check_pofd_sanity.py on
#   runs/pokec_gated_lm/pofddposmk_olmo7b_db0p1_ea0p1_open_s0_fresh
# and submit olmo7b_dpo ONLY on PASS. FIRST time DPO has been run on OLMo in
# this pipeline -- do not skip this.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7b_dpo_smoke
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) RLHF_FEEDBACK=$(rlhf) DPO_BETA=$(dpobeta) DPO_TAU=12.0 DPO_GEN_TEMP=1.0 DPO_MAX_STEPS=3 DPO_N_PAIRS=0 SFT_EPOCHS=0 SFT_LR=5e-5 LORA_R=128 USE_LORA=1 DO_SAMPLE=0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=3 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7b_pofddposmk"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, rlhf, dpobeta from experiments/condor/configs_pofd_olmo7b_dpo_smoke.txt
