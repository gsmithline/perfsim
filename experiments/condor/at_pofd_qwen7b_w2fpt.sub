# HTCondor: PRISTINE-TEACHER KL WAVE (pofdw2fpt_), Qwen-7B, seed 0.
# 8 runs: beta {0.1,0.2,0.5,1} x eps_AI {0.2,0.4}. IDENTICAL to
# at_pofd_qwen7b_w2f.sub (forward KL, W_PLAT=0.5 queue col 12,
# INNATE_LAMBDA=0.2, eps_social=0, fresh+replace) except KL_REF_ADAPTER:
# the KL reference is base + the pofdw2_ b0 run's round0_adapter merged --
# Train(base, D_pristine), one SFT epoch on the 723 innate labels
# (measured: corr(pred, innate) 0.879, mae 0.046, mean 0.643; the raw base
# prior is bimodal 0.25/0.65 with corr 0.04). Reviewer claim under test:
# the population effect depends on the CONTENT of the reference
# distribution, not only on the presence of a KL penalty. Compare per cell:
# w2f (base ref = pretrained prior), THIS (population ref), pf2 (the same
# anchor content in data space). b0 column = pofdw2_ b0 runs (no KL -> no
# teacher; reused, not re-run).
# PREREQ: runs/pokec_gated_lm/pofdw2_qwen7b_b0_ea0p4_w0p5_l0p2_s0_fresh_data/
# round0_adapter must exist on the cluster (it does, 2026-08-04 audit).
# Gate: qwen7b_w2fpt_smoke PASS (check_pofd_sanity + config.json
# kl_ref_adapter set) BEFORE this wave -- KL_REF_ADAPTER is a new code path.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_w2fpt
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) KL_DIRECTION=forward KL_REF_ADAPTER=/home/gsmithline/perfsim/runs/pokec_gated_lm/pofdw2_qwen7b_b0_ea0p4_w0p5_l0p2_s0_fresh_data/round0_adapter INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdw2fpt"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b_w2fpt.txt
