# ICL loop, OLMo rows (separate sub for the lustre HF_HOME cache,
# BATCHES gotcha 3): full factorial D{0,15} x K{0,8,32} minus frozen
# corner x {e040,e010} = 10 rows. Reads in Q8. 2026-07-16.
# Submit AFTER at_icl_smoke passes:
#   condor_submit_bid <BID> experiments/condor/at_icl_loop_olmo.sub
#
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=0 EPS_AI=$(eps_ai) PRISTINE_FRAC=$(pfrac) FRESH_EACH_ROUND=$(fresh) TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=$(base) SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=$(uselora) SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_icl_loop HF_HOME=/lustre/fast/fast/gsmithline/hf_cache ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=$(iclsel)"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)
# auto-release transient node/GPU-enumeration holds (bounded: <5 starts,
# 3-min backoff) so a bad node re-rolls itself; a real bug still stops after 5.
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac, fresh, base, uselora, iclk, icldays, iclsel from experiments/condor/configs_icl_loop_olmo.txt
