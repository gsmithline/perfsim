# HTCondor: FORWARD-KL WAVE (canonical 2026-07-29), W=0.5 FJ ENVIRONMENT
# (pofdw2f_), Qwen-7B, seed 0.
# 4 runs: beta {0.1,0.2,0.5,1} x eps_AI 0.4 -- the claim-carrying cells of the
# pofdw2_ wave (corrected operator, W_PLAT=0.5 queue col 12, INNATE_LAMBDA=0.2
# env-only, eps_social=0) re-run with KL_DIRECTION=forward: the anchor becomes
# KL(ref || pi) (mass-covering; SFT+KL optimum = CE to the mixture
# (data + beta*base)/(1+beta)) instead of reverse KL(pi || ref) (mode-seeking;
# RLHF convention, all pre-2026-07-28 waves). Forward is the paper's canonical
# anchor from 2026-07-29; the reverse pofdw2_ wave remains as the
# RLHF-practice comparison. beta=0 is direction-independent (reuse pofdw2_
# b0). Cells cover the strong-beta capture ramp (b0p5/b1) and the mild-beta
# lag-ratchet (b0p1/b0p2) at the wide gate.
# No separate smoke: the forward loss path was validated by the w1f
# smoke+wave and this environment is validated under reverse -- the direction
# only touches the loss term. Gate the wave itself with check_pofd_sanity.py
# + config.json kl_direction=forward after pulling.
# Everything else IDENTICAL to at_pofd_qwen7b_w2.sub, distinct pofdw2f_ tags.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_w2f
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) KL_DIRECTION=forward INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdw2f"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b_w2f.txt
