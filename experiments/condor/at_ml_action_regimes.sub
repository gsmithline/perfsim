# HTCondor: training-regime extension of the eps2d grid, MovieLens-Action (LLM). 4 runs.
#
# Cell e040_a040 -- the trap corner under replace (apparent RMSE 0.008 vs true
# 0.102, dr=0.48 at b0; b3 rescues dr but displaces the mean -0.17).
# x beta {0,3} x {accumulate (pfrac=0), pristine (pfrac=0.5)}. Continual weights,
# TRAIN_CAP=723 volume-matches replace. Question: does pristine keep true error
# near the replace-round-0 level while dr stays near 1?
# Submit: condor_submit_bid <BID> experiments/condor/at_ml_action_regimes.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) PRISTINE_FRAC=$(pfrac) TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_mla2dr"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac from experiments/condor/configs_ml_action_regimes.txt
