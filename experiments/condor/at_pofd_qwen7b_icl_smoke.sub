# HTCondor: pofdicl_ SMOKE -- 1 job, 3 rounds, distinct pofdiclsmk_ tag so it
# never collides with the real wave. k32 pristine arm (exercises exemplar
# building, the ctx-source swap, and the long-prompt gen-batch drop) at
# eps_AI=0.1. Identical env to at_pofd_qwen7b_icl.sub except N_ROUNDS=3 +
# smoke wandb suffix. Gate with check_pofd_sanity.py on
#   runs/pokec_gated_lm/pofdiclsmk_qwen7b_ea0p1_k32pri_s0
# and submit qwen7b_icl ONLY on PASS.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_icl_smoke
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "DEBUG_GEN=1 DEBUG_GEN_N=12 REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=random ICL_CTX_SOURCE=$(iclsrc) USE_LORA=0 FRESH_EACH_ROUND=0 TRAIN_CAP=723 N_ROUNDS=3 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_pofdiclsmk"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, iclk, icldays, iclsrc from experiments/condor/configs_pofd_qwen7b_icl_smoke.txt
