# HTCondor: IN-CONTEXT WAVE, W=0.5 FJ ENVIRONMENT (pofdicl2_), Qwen-7B, seed 0.
# 32 runs: 8 arms x eps_AI {0.05,0.1,0.2,0.4} -- the pofdicl_ wave re-based
# into env2 (corrected operator, W_PLAT=0.5 queue col 12, INNATE_LAMBDA=0.2,
# eps_social=0), so the adaptation-mechanism comparison (SFT-KL vs ICL vs
# DPO) exists in the same environment as the w2f/ws2f forward waves. Frozen
# weights, NO gradients -- no loss term, so the KL direction does not apply
# (direction-free arm, comparable to both forward and reverse waves).
# Arms: k0 = frozen baseline; k8live/k32live = K exemplar lines (other
# users, labels from the LIVE loop buffer -- moving data anchor); k32pri =
# same K but INNATE labels (fixed anchor); d5/d10/d15/d30 = the agent's OWN
# last-D-day history. noai skipped: with eps_social=0 the no-AI twin reduces
# to innate drift from an innate start (= stays innate), so noai == pristine
# here; the peer twin at_pofd_qwen7b_icls2.sub carries the k32noai arm.
# ICL_SELECT=random for all rows. USE_LORA=0. The wrapper auto-drops
# GEN_BATCH_SIZE to 8 for K>=32 (long prompts, KV-cache).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# No separate smoke: frozen path validated by the W=1 icl wave, env2
# validated by w2/w2f/esf; the icls2 smoke covers the new frozen+twin combo.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_icl2
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=random ICL_CTX_SOURCE=$(iclsrc) INNATE_LAMBDA=0.2 USE_LORA=0 FRESH_EACH_ROUND=0 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_pofdicl2"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, iclk, icldays, iclsrc from experiments/condor/configs_pofd_qwen7b_icl2.txt
