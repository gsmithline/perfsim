# HTCondor: closed-loop RLHF (DPO) on Qwen-7B, 3 arms x 3 seeds = 9 runs, 30 rounds.
# INTERMEDIATE lever: the permissive run (at_rlhf_permissive.sub, eps_AI=2.0, W=0.5,
# no innate anchor) COLLAPSED — the AI overwrote the population in ~2 rounds, op_std
# hit 0, both temp candidates rounded to the same number -> ties=723 -> DPO skipped
# every round (5/6 runs), and one arm went degenerate (parse_fail=723 -> constant 0.5
# fallback). That made closed-open uninterpretable. This softens the lever so op_std
# stays > 0 and the loop actually runs 30 rounds with live feedback:
#   INNATE_LAMBDA=0.2  turn the innate re-anchor ON (was 0) -- pulls each agent toward
#                      its DISTINCT innate opinion every round -> non-degenerate spread.
#                      (This is the real anti-collapse knob; the local surrogate's kappa.)
#   W_PLAT   0.5 -> 0.4  (column) gentler platform blend weight.
#   EPS_AI   2.0 -> 0.6  (column) narrower AI gate (note: with spread ~0.09 this barely
#                        bites; INNATE_LAMBDA does the real work).
#   DPO_MAX_STEPS 8 -> 3  gentler DPO so the policy doesn't sharpen to a delta each round.
#   LORA_R   512 -> 128  smaller adapter -> less likely to break the model (the permissive
#                        closed_s0 diverged into non-numeric output at rank 512, 8 steps).
#   closed -> style=dpo, RLHF_FEEDBACK=closed (judge = own deployed population)
#   open   -> style=dpo, RLHF_FEEDBACK=open   (judge = no-AI twin ab_x_cf)
#   frozen -> style=frozen, USE_LORA=0        (base prior deployed every round)
# DPO reference = adapter-off base (fixed anchor; ref_model=None on the LoRA model).
# Candidates are TEMPERATURE-sampled (DPO_GEN_TEMP=1.0); deployed prediction stays greedy.
# Submit: condor_submit_bid <BID> experiments/condor/at_rlhf_intermediate.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) RLHF_FEEDBACK=$(rlhf) USE_LORA=$(uselora) PRISTINE_FRAC=$(pfrac) FRESH_EACH_ROUND=$(fresh) INNATE_LAMBDA=0.2 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=0 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=128 SFT_LR=5e-5 DO_SAMPLE=0 DPO_BETA=0.1 DPO_TAU=12.0 DPO_GEN_TEMP=1.0 DPO_MAX_STEPS=3 DPO_N_PAIRS=0 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_rlhfI"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac, fresh, rlhf, uselora from experiments/condor/configs_rlhf_intermediate.txt
