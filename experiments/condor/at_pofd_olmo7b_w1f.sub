# HTCondor: FORWARD-KL WAVE, W=1 ENVIRONMENT (pofdw1f_), OLMo-2-7B, seed 0.
# 4 runs: beta {0.1,0.2,0.5,1} x eps_AI 0.4 -- the olmo twin of
# at_pofd_qwen7b_w1f.sub: KL_DIRECTION=forward (KL(ref || pi), mass-covering;
# the paper's canonical anchor from 2026-07-29; reverse pofd_olmo7b_ remains
# as the RLHF-practice comparison, beta=0 direction-independent).
# The science: olmo's prior is a SINGLE spike at 0.75, ABOVE the population
# and inside almost every agent's gate (|0.75 - x| < 0.4), unlike qwen's
# distant 0.25 mode -- so the forward-vs-reverse threshold result (qwen fwd
# kills the b0p5 camp, reproduces the b1 camp) gets tested on a prior that
# overlaps the data. Capture metrics need the HIGH-side mirror of <0.45.
# Model deltas vs the qwen sub: BASE_MODEL, the separate lustre HF cache +
# HF_HUB_OFFLINE=1 (BATCHES.md gotcha 2026-07-15), PPL_BATCH=16 (no GQA),
# request_memory 160G / disk 60G. Otherwise identical.
# No separate smoke: forward loss path validated by the qwen w1f smoke+wave,
# olmo model path validated by its reverse waves. Gate the pulled runs on
# check_pofd_sanity.py + config.json kl_direction=forward.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7b_w1f
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) KL_DIRECTION=forward FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7b_lora512_pofdw1f"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_olmo7b_w1f.txt
