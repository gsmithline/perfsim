# HTCondor: FRESH x ACCUMULATE x FIXED-PRISTINE 50% -- the rescue arm.
#
# Same as fresh+accumulate (gfa) but PRISTINE_FRAC=0.5: every training subsample
# holds 50% round-0 real data (dep=-1) instead of letting it decay to ~1/t under
# random subsampling. This is the direct LLM test of the contamination theory:
#   gfa (PRISTINE_FRAC=0, decaying real) -> theory: bias accumulates, drift NOT bounded
#   gfp (PRISTINE_FRAC=0.5, fixed real)  -> theory: bounded floor (the rescue)
# FRESH_EACH_ROUND=1, TRAIN_CAP=1730 (volume-matched), lambda=0,
# eps {0.2,0.4} x beta {0,0.1,0.5,1}, seed 0, 60 rounds = 8 loop + 1 nf.
#
# Submit: condor_submit_bid 25 experiments/condor/at_pokec_gated_fpristine.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary) $(lam)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000) && (regexp("^g174", TARGET.Machine) =!= True)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-pokec-gated-lm FRESH_EACH_ROUND=1 PRISTINE_FRAC=0.5 TRAIN_CAP=1730 N_ROUNDS=60 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=1730 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_gated_fresh_accum_pristine50"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_fpristine.out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_fpristine.err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_fpristine.log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 5
on_exit_hold      = (ExitCode =!= 0) && (ExitCode =!= 17)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, lam from experiments/condor/configs_pokec_gated_fpristine.txt
