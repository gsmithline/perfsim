# HTCondor: innate-anchor x gate x KL grid -- the 3-way batch, 1 seed, 60 rounds.
#
# lambda {0, 0.1, 0.3} x eps {0.2, 0.4} x beta {0, 0.1, 0.5, 1}, seed 0, loop = 24 jobs,
# plus 3 no_feedback controls (lambda {0,0.1,0.3}, beta 0) = 27 jobs.
# Tests whether the population innate re-anchor lambda caps the recycled fraction s
# (now MEASURED directly via the provenance tag, not reconstructed) and floors the
# collapse, and how it trades off against the model-side KL anchor beta. beta swept
# fine on the low end {0,0.1,0.5,1} to locate the collapse->displacement transition.
# 1 seed for the general pattern; add seeds later for error bars.
# Uses the fixed runner (exit-17 fast-fail on broken CUDA; g174 excluded).
#
# Submit: condor_submit_bid 25 experiments/condor/at_pokec_gated_innate.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary) $(lam)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000) && (regexp("^g174", TARGET.Machine) =!= True)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-pokec-gated-lm N_ROUNDS=60 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=1730 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_gated_innate_60r"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_innate.out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_innate.err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_innate.log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 5
on_exit_hold      = (ExitCode =!= 0) && (ExitCode =!= 17)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, lam from experiments/condor/configs_pokec_gated_innate.txt
