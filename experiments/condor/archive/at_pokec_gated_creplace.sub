# HTCondor: CONTINUAL weights x REPLACE data -- 2x2 cell (continual+replace).
#
# The deployed-LLM default: weights persist across rounds (FRESH_EACH_ROUND=0),
# trained on only the latest population (replace). This is the corner where
# performative stability lives (RGD); w_step ||theta_t-theta_{t-1}|| should decay
# at a stable point and fail to decay at the beta=0 instability. lambda=0,
# eps {0.2,0.4} x beta {0,0.1,0.5,1}, seed 0, 60 rounds = 8 loop + 1 nf.
# Completes the 2x2 with gca (continual+accum), gfr (fresh+replace), gfa (fresh+accum).
#
# Submit: condor_submit_bid 25 experiments/condor/at_pokec_gated_creplace.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary) $(lam)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000) && (regexp("^g174", TARGET.Machine) =!= True)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-pokec-gated-lm FRESH_EACH_ROUND=0 N_ROUNDS=60 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=1730 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_gated_continual_replace"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_creplace.out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_creplace.err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag)_creplace.log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 5
on_exit_hold      = (ExitCode =!= 0) && (ExitCode =!= 17)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, lam from experiments/condor/configs_pokec_gated_creplace.txt
