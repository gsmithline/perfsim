# HTCondor: PLATFORM-ONLY CLOSED LOOP, FRESH DATA (pofd_), Qwen-7B, seed 0. 20 runs:
# beta {0,0.1,0.2,0.5,1} x eps_AI {0.05,0.1,0.2,0.4}. (eps_AI=0 zero-dose column
# briefly added then DROPPED 2026-07-22: the olmo7b wave confirmed it fully inert,
# gate never opens, acceptance 0.00 -- see gen_pofd_sweep.py. All 20 qwen cells are
# done; resubmitting no-ops.) Cross-model twins: at_pofd_gemma12b.sub / at_pofd_olmo7b.sub.
# Isolates the pure model<->population channel: eps_social=0.0 (ab_sweep accepts a
# peer pair only if |xi-xj| < eps, so the peer step NEVER fires -- row 'accepted'
# must be 0 every round), W_PLAT=1.0 (movielens platform_sus is all-ones, so a
# gated agent's opinion becomes EXACTLY the served prediction), FRESH_EACH_ROUND=1
# + regime=replace (each retrain restarts from the pristine adapter and sees ONLY
# the most recent round's data -- no replay, no accumulation through weights).
# Grid: beta {0,0.1,0.2,0.5,1} x eps_AI {0.05,0.1,0.2,0.4}; beta=0 -> sft, else
# sft_kl. Everything else = the default closed-loop cell (at_ml_action_fresh_v2).
# Configs are GENERATED -- edit gen_pofd_sweep.py, never the .txt by hand.
# Idempotent executable: a finished run (trajectory.pt >= N_ROUNDS) re-exits 0,
# so hold/release cycles and resubmits are cheap no-ops (restartable).
# Sanity gate AFTER smoke: python experiments/scripts/cluster_pipelines/check_pofd_sanity.py
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> full
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofd"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_qwen7b.txt
