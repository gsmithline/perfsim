# HTCondor: W=0.5 FJ NOISY-DPO WAVE (pofdwdpon_), Qwen-7B, seed 0. 8 runs:
# DPO_BETA {0.1,0.5} x RLHF_FEEDBACK {closed,open} x eps_AI {0.2,0.4} -- the
# pofddpon_ grid (DO_SAMPLE=1 sampled serving, DPO_TAU=3 soft grading) re-run
# at W_PLAT=0.5 + INNATE_LAMBDA=0.2. The decisive test of the W=1 finding
# that the round-0 sampled low-serving accident is PERMANENT: at W=0.5 the
# captured tail only moves halfway and heals at rate lam, so the open-arm
# dispersion (op_std 0.23-0.25 at W=1) should shrink or vanish if the
# stranding mechanism -- not the sampling itself -- was the damage.
# ANS_SAMPLE_K=16 probe ON. Everything else IDENTICAL to at_pofd_qwen7b_dpon.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Flow: gated by qwen7b_wdpo_smoke (same config surface; DO_SAMPLE/TAU were
# smoked at W=1 by pofddponsmk_). Submit only after that smoke PASSES sanity.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_wdpon
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) RLHF_FEEDBACK=$(rlhf) DPO_BETA=$(dpobeta) DPO_TAU=3.0 DPO_GEN_TEMP=1.0 DPO_MAX_STEPS=3 DPO_N_PAIRS=0 INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 SFT_EPOCHS=0 SFT_LR=5e-5 LORA_R=128 USE_LORA=1 DO_SAMPLE=1 GEN_TEMPERATURE=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_pofdwdpon"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, rlhf, dpobeta from experiments/condor/configs_pofd_qwen7b_wdpon.txt
