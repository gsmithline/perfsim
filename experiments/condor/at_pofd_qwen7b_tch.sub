# HTCondor: CONTROLLED-TEACHER TRAINING PAIR (pofdtch_), Qwen-7B, 2 jobs.
# One-round SFT teachers on TRANSFORMED pristine labels
#   y_i_teacher = clip(y_i + delta * (2*1[gender_i == M] - 1), 0, 1)
# at TEACHER_LABEL_DELTA {+0.08, -0.08} (queue col 16). Same budget as every
# round-0 teacher (1 epoch, LoRA r512, lr 5e-5, batch 4, 723 rows, seed 0);
# N_ROUNDS=1 -- we keep round0_adapter (the teacher) + pred_raw[0] (its
# prediction distribution). The delta-0 neutral teacher is REUSED from
# pofdw2_qwen7b_b0_ea0p4_w0p5_l0p2_s0_fresh_data (w2fpt pristine teacher).
# The transform touches initial_data labels ONLY (innate/population/twin/
# buffer untouched -- runner enforces sft-only + natural profiles) and is
# recorded in config (teacher_label_col/fav/delta). LOG_GENDER_GAPS=1:
# gg_pred_true in the single row = the teacher's signed gender gap.
# GATE before the tfe loop wave (registered 2026-08-04; g = gg_pred_true,
# the teacher's prediction gap by true gender; g0 = the neutral teacher's
# gap, computed from pofdw2_ b0 pred_raw[0] + its saved profiles):
#   (1) signs        g+ > 0 > g-
#   (2) magnitude    |g+| >= 0.05 and |g-| >= 0.05 (>= ~1/3 of the
#                    injected 0.16 label gap surviving the fit)
#   (3) symmetry     max(|g+|,|g-|) / min(|g+|,|g-|) <= 2
#   (4) no collapse  each teacher: pred_std >= 0.08, corr(pred, innate)
#                    >= 0.6, eff_support >= 8 (neutral measured 0.1255 /
#                    0.879 / 18.5)
#   (5) ordering     g- < g0 < g+
# Baselines (measured from data 2026-08-04): innate gender gap +0.0021
# (~zero), so label gaps are near-symmetric +0.162/-0.158 (clip touches
# 4/2 of 723 rows) and any teacher gap is essentially pure injection.
# check_pofd_sanity is_tch verifies delta-vs-tag, the exact transformed
# round-0 labels (round0_batch.pt vs innate + delta*sign), and the
# environment.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_tch
# Flow: qwen7b_tch -> gap gate -> qwen7b_tfe_smoke -> sanity PASS ->
#       qwen7b_tfe (15 jobs).
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) TEACHER_LABEL_DELTA=$(tdelta) LOG_GENDER_GAPS=1 INNATE_LAMBDA=0.2 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=1 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdtch"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, tdelta from experiments/condor/configs_pofd_qwen7b_tch.txt
