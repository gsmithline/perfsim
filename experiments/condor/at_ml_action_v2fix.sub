# HTCondor: POST-RNG-FIX calibration, MovieLens-Action (LLM). 4 runs.
#
# First batch after the frozen-pair fix; v2 tags never comparable to pre-fix.
#   mla2dv2_e040_a040_{b0,b3}       replace/continual trap cell re-run
#   mla2gv2_e040_a040_{gp15,gn15}   gamma arms (gamma is MOST exposed to the bug)
# Key reads: does the trap (apparent 0.008 / true 0.102 / dr 0.48) survive true
# mixing; does the gamma ordering homo > neutral > hetero hold.
# Submit: condor_submit_bid <BID> experiments/condor/at_ml_action_v2fix.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_mlav2fix"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_ml_action_v2fix.txt
