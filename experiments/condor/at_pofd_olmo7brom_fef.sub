# HTCondor: OLMo ROMANCE FE MIRROR, frozen no-context arm (fef), 3 jobs:
# k0 x seeds {0, 42, 43} at ea0p4 in the peer environment (corrected
# operator, W_PLAT=0.5, INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2 queue col 10),
# BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct, ML_TARGET=Romance. Frozen
# weights, no gradients, no context (K=0, D=0) -- the model serves its
# zero-shot Romance prior every round while the population moves;
# KL-direction-free. Tags stay in the pofdicls2_ family with the TARGET
# token in the model slot (olmo7brom). The qwen/Action counterpart is the
# pofdicls2_ k0 trio (fef wave). NO anchors exist (Romance never ran) --
# all 3 seeds run. Twin forced on every run (eps>0).
# Romance population = Action's LCC (n=723, 520 M / 203 F, measured
# 2026-08-05); innate M-F gap -0.0149, mean 0.6641. Prompts exclude
# Romance, include Action (loader feats = core minus target).
# Model deltas vs the qwen icls2 sub: BASE_MODEL, lustre HF cache +
# HF_HUB_OFFLINE=1, PPL_BATCH=16, request_memory 160G / disk 60G.
# ICL_SELECT=random, USE_LORA=0. check_pofd_sanity: peer gate + icl arm
# checks + olmo7brom token (ml_target=Romance, OLMo-2 base_model); FRESH
# gate skipped (frozen, no n_train).
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Flow: olmo7brom_fe_smoke -> sanity PASS -> olmo7brom_fe (fes + fef).
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7brom_fe
#         (composite), or olmo7brom_fef alone.
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000) && (TARGET.Machine =!= MY.LastRemoteHost) && (TARGET.Machine != "g106.internal.cluster.is.localnet")

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Romance HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) ICL_K=$(iclk) ICL_DAYS=$(icldays) ICL_SELECT=random ICL_CTX_SOURCE=$(iclsrc) INNATE_LAMBDA=0.2 USE_LORA=0 FRESH_EACH_ROUND=0 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct GEN_BATCH_SIZE=32 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7brom_pofdicls2"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, iclk, icldays, iclsrc from experiments/condor/configs_pofd_olmo7brom_fef.txt
