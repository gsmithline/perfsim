# HTCondor: closed-loop RLHF (DPO) on Qwen-7B, 3 arms x 3 seeds = 9 runs, 30 rounds.
# Tests whether closed-loop RLHF REINFORCES the model's initial opinion bias because
# it deploys into -> reshapes -> the very population that later grades its preferences.
# The closed - open contrast isolates the model-mediated feedback channel (identical
# DPO + dynamics; only the preference-label source differs). Cluster port of the
# validated local surrogate (notes/rlhf_closed/); the local effect appeared here, at
# the PERMISSIVE lever (eps_AI=2.0, W=0.5, innate anchor off), on all seeds.
#   closed -> style=dpo, RLHF_FEEDBACK=closed (judge = own deployed population)
#   open   -> style=dpo, RLHF_FEEDBACK=open   (judge = no-AI twin ab_x_cf)
#   frozen -> style=frozen, USE_LORA=0        (base prior deployed every round)
# DPO reference = adapter-off base (fixed anchor; ref_model=None on the LoRA model),
# so no second 7B in memory. Candidates are TEMPERATURE-sampled (DPO_GEN_TEMP);
# the DEPLOYED prediction stays greedy/mode (DO_SAMPLE=0).
# RUN THE SMOKE (at_rlhf_smoke.sub) FIRST. Submit: condor_submit_bid <BID> experiments/condor/at_rlhf_permissive.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) RLHF_FEEDBACK=$(rlhf) USE_LORA=$(uselora) PRISTINE_FRAC=$(pfrac) FRESH_EACH_ROUND=$(fresh) TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=0 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 SFT_LR=5e-5 DO_SAMPLE=0 DPO_BETA=0.1 DPO_TAU=12.0 DPO_GEN_TEMP=0.8 DPO_MAX_STEPS=8 DPO_N_PAIRS=0 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_rlhfP"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac, fresh, rlhf, uselora from experiments/condor/configs_rlhf_permissive.txt
