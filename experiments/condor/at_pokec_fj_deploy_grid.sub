# HTCondor: deployment schedule experiment, re-run with betas and FIXED.
#
# Same 6 deployment cells as the original factorial (K1 replace/accumulate;
# K3 replace/accumulate/deployed_into/not_deployed_into), now crossed with the
# KL anchor beta {0,1,3}, 1 seed each = 18 runs.
#
# FIX: SEED_BASE_DATA=1 puts the real base data into the data buffer, so regimes
# that use the full history (accumulate, not_deployed_into) include it and
# recent-only regimes (replace, deployed_into) do not -- the intended behavior.
# style is per-row (sft for beta=0, sft_kl for beta>0 so kl_beta is applied).
# 7B LoRA r=512 to match the original runs.
#
# Submit: condor_submit_bid <BID> experiments/condor/at_pokec_fj_deploy_grid.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_fj.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-pokec-fj-lm N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=1730 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_fix"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime from experiments/condor/configs_pokec_fj_deploy_grid.txt
