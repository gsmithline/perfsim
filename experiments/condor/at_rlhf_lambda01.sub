# HTCondor: closed-loop RLHF (DPO) on Qwen-7B, 3 arms x 3 seeds = 9 runs, 30 rounds.
# LAMBDA=0.1 probe: the intermediate run (at_rlhf_intermediate.sub, INNATE_LAMBDA=0.2)
# did NOT collapse (op_std floored ~0.05, all 30 rounds ran) but gave a NULL closed-open
# contrast (op_bias mixed sign +0.06/+0.02/-0.03; op_std mixed too). The arms DID diverge
# (|closed_op - open_op| ~ op_std), so the null is "no consistent direction", not "no
# divergence". This weakens the innate anchor to 0.1 (closer to the permissive regime
# where the local surrogate showed a clean effect) to amplify the closed-vs-open
# separation -- at the cost of higher collapse / policy-degeneracy risk. ONLY change vs
# at_rlhf_intermediate.sub is INNATE_LAMBDA 0.2 -> 0.1 (variable isolated).
#   closed -> style=dpo, RLHF_FEEDBACK=closed (judge = own deployed population)
#   open   -> style=dpo, RLHF_FEEDBACK=open   (judge = no-AI twin ab_x_cf)
#   frozen -> style=frozen, USE_LORA=0        (base prior deployed every round)
# Submit: condor_submit_bid <BID> experiments/condor/at_rlhf_lambda01.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) RLHF_FEEDBACK=$(rlhf) USE_LORA=$(uselora) PRISTINE_FRAC=$(pfrac) FRESH_EACH_ROUND=$(fresh) INNATE_LAMBDA=0.1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=0 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=128 SFT_LR=5e-5 DO_SAMPLE=0 DPO_BETA=0.1 DPO_TAU=12.0 DPO_GEN_TEMP=1.0 DPO_MAX_STEPS=3 DPO_N_PAIRS=0 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_rlhfL"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac, fresh, rlhf, uselora from experiments/condor/configs_rlhf_lambda01.txt
