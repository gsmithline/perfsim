# HTCondor: RANDOM-EVEN-SPLIT TEACHER PAIR (pofdtchr_), Qwen-7B, 2 jobs.
# Twin of at_pofd_qwen7b_tch.sub with the favored set a SYNTHETIC balanced
# random split (TEACHER_LABEL_COL=random_even, groups A/B 361/362, FAV=A,
# split seeded 52100+TEACHER_GROUP_SEED, run-seed-INDEPENDENT, saved to
# random_group.json). NO prompt feature marks membership -- a teacher can
# carry the +/-0.08 label signal ONLY by memorizing individual profiles.
# Separates feature-mediated endogenization (gender wave) from instance-
# memorization transfer; group-size asymmetry (520/203) removed.
# GATE before the tfer loop wave: signs opposite + no collapse + neutral
# between are HARD gates (same floors as the gender pair); the MAGNITUDE
# here is stage 1's measurement -- a small gap IS the memorization limit,
# a result, not a pipeline failure. Proceed to stage 2 only if both
# |gaps| >= 0.05; otherwise report and stop for a decision.
# check_pofd_sanity is_tch (pofdtchr branch): col=random_even, fav=A,
# delta-vs-tag, exact transformed labels vs the saved split.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> qwen7b_tchr
# Flow: qwen7b_tchr -> gap gate -> qwen7b_tfer_smoke -> sanity PASS ->
#       qwen7b_tfer (6 jobs; tneu REUSED from pofdtfe_, recomputed offline).
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) TEACHER_LABEL_DELTA=$(tdelta) TEACHER_LABEL_COL=random_even TEACHER_LABEL_FAV=A TEACHER_GROUP_SEED=0 LOG_GENDER_GAPS=1 INNATE_LAMBDA=0.2 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=1 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=64 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_qwen7b_lora512_pofdtchr"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, tdelta from experiments/condor/configs_pofd_qwen7b_tchr.txt
