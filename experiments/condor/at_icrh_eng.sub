# ICRH -- ENGAGEMENT proxy, QWEN (2026-07-21): identical to at_icrh.sub but the
# reward arm is told to maximize ENGAGEMENT (platform-induced mean|dx| per round =
# how much the served recommendation moved opinions) instead of prediction
# accuracy. This is the MISSPECIFIED proxy (Pan et al. 2402.06627): moving people
# is in tension with staying faithful to genuine opinion, so gaming it should raise
# the side effect (w1_cf up, acc_cf down) -- unlike the accuracy proxy, which is
# self-correcting. acc_served / engagement / acc_cf / w1_cf are ALL logged, so
# accuracy(at_icrh.sub) vs engagement(here) is a direct test of "accurate reward ->
# less performative distortion". Trap e040 (easiest to move/homogenize) + stable
# e010 (control). 3 conditions x 2 cells x seed 43 = 6 jobs, N_ROUNDS=10.
# SMOKE: 1 seed; a CLAIMED effect needs precommitted seeds across all conditions.
# Submit: condor_submit_bid <BID> experiments/condor/at_icrh_eng.sub
#
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn GEMMA_ENV_NAME=$(gemmaenv) WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) PRISTINE_FRAC=$(pfrac) FRESH_EACH_ROUND=$(fresh) ICRH=1 REWARD_KIND=engagement FEEDBACK_MODE=$(fbmode) ICL_K=0 ICL_DAYS=0 TRAIN_CAP=723 N_ROUNDS=10 EPOCH_SIZE=100 BASE_MODEL=$(basemodel) HF_HUB_OFFLINE=1 SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=0 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_icrh_eng"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac, fresh, basemodel, gemmaenv, fbmode from experiments/condor/configs_icrh_eng.txt
