# HTCondor: OLMo ROMANCE FE MIRROR, natural-gender arm (fes), 9 jobs:
# beta {0, 0.5, 1} x seeds {0, 42, 43} at ea0p4 in the peer environment
# (corrected operator, W_PLAT=0.5, INNATE_LAMBDA=0.2, EPS_SOCIAL=0.2 queue
# col 10), KL_DIRECTION=forward, replace + fresh adapter each round,
# BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct, ML_TARGET=Romance. The
# second-model x second-target replication of the qwen/Action fes wave
# (at_pofd_qwen7b_fes.sub): tags stay in the pofdws2f_ family with the
# TARGET token in the model slot (olmo7brom); b0 rows style sft
# (direction-free). NO anchors exist -- Romance never ran anywhere -- so
# all 9 cells run, including b0 and seed 0.
# Romance population (measured 2026-08-05, local loader): same LCC as
# Action -- n=723, 520 M / 203 F -- so TRAIN_CAP/N_LABELED stay 723.
# Baseline flips: innate M-F gap -0.0149 (women rate Romance higher;
# Action was +0.0021), innate mean 0.6641 std 0.1243. Profiles/prompts
# exclude Romance and include Action (loader feats = core minus target).
# Twin forced on every run (eps>0); per-agent op_raw/pred_raw/twin_raw
# land in trajectory.pt as always.
# Model deltas vs the qwen fes sub: BASE_MODEL, lustre HF cache +
# HF_HUB_OFFLINE=1, PPL_BATCH=16, request_memory 160G / disk 60G.
# Gate at pull: check_pofd_sanity.py (olmo7brom token -> ml_target=Romance
# + OLMo-2 base_model) + config.json kl_direction=forward on b>0 rows.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Flow: olmo7brom_fe_smoke -> sanity PASS -> olmo7brom_fe (fes + fef).
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7brom_fe
#         (composite), or olmo7brom_fes alone.
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000) && (TARGET.Machine =!= MY.LastRemoteHost) && (TARGET.Machine != "g106.internal.cluster.is.localnet")

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Romance HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) KL_DIRECTION=forward INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7brom_lora512_pofdfes"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_olmo7brom_fes.txt
