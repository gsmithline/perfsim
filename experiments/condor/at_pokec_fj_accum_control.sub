# HTCondor: accumulate collapse control -- volume vs real-data anchor, crossed with beta.
#
# Tests whether K3_accumulate's perplexity blowup is driven by (A) training on a
# growing pile of stale self-generated data, or (B) just training on far more
# tokens. TRAIN_CAP matches replace's per-round volume (controls B); ANCHOR_REAL
# re-injects the real innate labels each retrain (the missing data anchor, controls A).
# Crossed with the model-side KL anchor beta in {0,1,3} to see if the data anchor
# and beta substitute or complement. 5 cells x 3 betas x 3 seeds = 45 runs, K=3,
# 7B LoRA r=512 to match the original schedule/beta runs. style is per-row in the
# config (sft for beta=0, sft_kl for beta>0 so kl_beta is actually applied).
#
# Submit: condor_submit_bid <BID> experiments/condor/at_pokec_fj_accum_control.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_fj.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(train_cap) $(anchor)

request_cpus      = 4
request_memory    = 128G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-pokec-fj-lm N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=1730 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 WANDB_RUN_SUFFIX=_qwen7b_lora512_ctrl"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, train_cap, anchor from experiments/condor/configs_pokec_fj_accum_control.txt
