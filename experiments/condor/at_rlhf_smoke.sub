# HTCondor SMOKE: closed-loop RLHF (DPO), 3 arms, tiny model, 2 rounds, 1 seed.
# Validates the new TRAINING_STYLE=dpo code path end-to-end (candidate sampling,
# BT preference labels, DPOTrainer step, closed-vs-open judge population) BEFORE
# spending 7B GPU-hours. Run this first; inspect logs; then submit the real batch.
#   closed -> dpo, RLHF_FEEDBACK=closed (judge = own deployed population)
#   open   -> dpo, RLHF_FEEDBACK=open   (judge = no-AI twin ab_x_cf)
#   frozen -> style=frozen, USE_LORA=0  (base prior deployed every round)
# Permissive lever (where the local effect appears): eps_AI=2.0, W=0.5, kappa/innate=0.
# Submit: condor_submit_bid <BID> experiments/condor/at_rlhf_smoke.sub

universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 64G
request_disk      = 40G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 20000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action EPS_AI=$(eps_ai) RLHF_FEEDBACK=$(rlhf) USE_LORA=$(uselora) PRISTINE_FRAC=$(pfrac) FRESH_EACH_ROUND=$(fresh) TRAIN_CAP=723 N_ROUNDS=2 EPOCH_SIZE=100 BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct SFT_EPOCHS=0 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=64 SFT_LR=5e-5 DO_SAMPLE=0 DPO_BETA=0.1 DPO_TAU=12.0 DPO_GEN_TEMP=1.0 DPO_MAX_STEPS=4 DPO_N_PAIRS=128 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=0 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_rlhf_smoke"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
max_retries       = 2
on_exit_hold      = (ExitCode =!= 0)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai, pfrac, fresh, rlhf, uselora from experiments/condor/configs_rlhf_smoke.txt
