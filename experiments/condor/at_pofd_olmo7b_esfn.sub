# HTCondor: NARROW-GATE SOCIAL-DOSE matrix (esfn), OLMo-2-7B half. 26
# runs: the audited-missing cells of ea {0.05, 0.10} x es {0, 0.10, 0.15,
# 0.20, 0.25} x s {0, 42, 43} -- forward SFT-KL b1, W_PLAT=0.5,
# INNATE_LAMBDA=0.2, gamma=0, corrected nested operator, fresh + replace,
# 30 rounds, movielens Action. es + W ride the queue (cols 10/12), eps_AI
# col 15. The matched qwen twin is at_pofd_qwen7b_esfn.sub -- the science:
# does peer repair vs a barely-open narrow gate behave the same for
# qwen's out-of-range 0.25 prior and olmo's in-range 0.75 spike? First
# olmo7b tags in the pofdesf_ family (mid doses; the checker is
# model-agnostic and routes by the _w/_l/_es tokens).
# AUDIT 2026-08-05 (on-cluster, all tags): the es {0, 0.2} s0 gate cells
# exist (pofdw2f_/pofdws2f_ olmo7b b1_ea0p05/b1_ea0p1, gated at pull) and
# are REUSED, not re-run -- NOT in this config. Tags stay in the per-dose
# home families: es=0 -> pofdw2f_, es=0.2 -> pofdws2f_, mid -> pofdesf_.
# WITH_TWIN=1: every run saves the matched no-platform twin (twin_raw;
# RNG-mirrored peers, deterministic innate drift at es=0). The reused
# es=0 s0 runs predate WITH_TWIN -- twin computed offline (esf precedent).
# Model deltas vs the qwen esfn sub: BASE_MODEL, lustre HF cache +
# HF_HUB_OFFLINE=1, PPL_BATCH=16, request_memory 160G / disk 60G.
# check_pofd_sanity: es>0 rows peer gate (mean-conservation + twin), es=0
# rows exact replay. Gate every pull + config.json kl_direction=forward.
# No smoke: WITH_TWIN + peer env + forward sft_kl on olmo validated by
# the w2fx/ws2fx and ws2f waves; only queue-fed dials differ.
# Configs GENERATED by gen_pofd_sweep.py -- never edit the .txt by hand.
# Submit: bash experiments/condor/submit_pofd_sweep.sh <BID> olmo7b_esfn
universe          = vanilla
executable        = /home/gsmithline/perfsim/experiments/condor/run_one_pokec_gated_idempotent.sh
arguments         = $(tag) $(style) $(beta) $(seed) $(deploy_every) $(regime) $(pscale) $(anchor) $(pop) $(eps) $(gamma) $(wplat) $(mode) $(canary)

request_cpus      = 4
request_memory    = 160G
request_disk      = 60G
request_gpus      = 1
requirements      = (TARGET.CUDAGlobalMemoryMb >= 80000)

getenv            = False
environment       = "REPO=/home/gsmithline/perfsim CONDA_SH=/home/gsmithline/miniconda3/etc/profile.d/conda.sh ENV_NAME=opdyn WANDB_KEY_FILE=/home/gsmithline/.wandb_key WANDB_PROJECT=perfsim-gated-lm DATASET=movielens ML_TARGET=Action HF_HOME=/lustre/fast/fast/gsmithline/hf_cache HF_HUB_OFFLINE=1 EPS_AI=$(eps_ai) KL_DIRECTION=forward WITH_TWIN=1 INNATE_LAMBDA=0.2 ANS_SAMPLE_K=16 ANS_SAMPLE_N=64 ANS_SAMPLE_T=1.0 FRESH_EACH_ROUND=1 TRAIN_CAP=723 N_ROUNDS=30 EPOCH_SIZE=100 BASE_MODEL=allenai/OLMo-2-1124-7B-Instruct SFT_EPOCHS=1 SFT_BATCH_SIZE=4 GEN_BATCH_SIZE=32 LORA_R=512 USE_LORA=1 SFT_LR=5e-5 N_LABELED=723 HIST_BINS=50 LOG_PERPLEXITY=1 N_PERPLEXITY=64 LOG_PPL_DIST=1 PPL_DIST_CAP=0 PPL_BATCH=16 SEED_BASE_DATA=1 WANDB_RUN_SUFFIX=_olmo7b_lora512_pofdesfn"

output            = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).out
error             = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).err
log               = /home/gsmithline/perfsim/experiments/condor/logs/$(tag).log

notification      = Complete
notify_user       = gabriel.smithline@tue.ellis.eu
on_exit_hold      = (ExitCode =!= 0)
periodic_release  = (NumJobStarts < 5) && ((time() - EnteredCurrentStatus) > 180)
periodic_remove   = (JobStatus == 5) && (NumJobStarts >= 5) && ((time() - EnteredCurrentStatus) > 600)

queue tag, style, beta, seed, deploy_every, regime, pscale, anchor, pop, eps, gamma, wplat, mode, canary, eps_ai from experiments/condor/configs_pofd_olmo7b_esfn.txt
