# OpenRouter frontier-model serving (MODEL_BACKEND=openrouter).
# COPY to .env and fill in locally. .env is git-ignored; the real key must
# NEVER appear in Condor arguments, job metadata, a run config, a cache, a
# log line, an exception message, or Git.
OPENROUTER_API_KEY=sk-or-REPLACE-ME

# Cluster alternative: point at a mode-0600 file holding ONLY the key, so
# the value never enters a Condor classad or the job environment string.
#   ssh login: printf %s 'sk-or-...' > ~/.openrouter_key && chmod 600 ~/.openrouter_key
# OPENROUTER_API_KEY_FILE=/home/gsmithline/.openrouter_key
